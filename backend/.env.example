# ==============================================================================
# DecisionTrace Backend Environment Variables Configuration
# ==============================================================================

# Application Environment: 'development', 'test', or 'production'
APP_ENV=development

# Authentication Dev Bypass: STRICTLY FORBIDDEN IN PRODUCTION
# When APP_ENV=production, setting this to True triggers a fatal startup crash.
AUTH_DEV_MODE=False

# Database (PostgreSQL / Neon in Production, SQLite in Development)
# Neon PostgreSQL example: postgresql+psycopg://user:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./decisiontrace.db

# Redis / RQ Task Queue (Railway Redis in Production)
# Railway Redis example: redis://default:secret_pass@redis.railway.internal:6379
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=default

# Qdrant Vector Database (Qdrant Cloud in Production)
# Qdrant Cloud example: https://xyz-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=conversation_chunks_v1

# FastEmbed Embedding Engine (Dense 384-dimensional vectors)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_PATH=

# Production Clerk Authentication (JWKS RS256 Verification)
# In production, CLERK_ISSUER and CLERK_JWKS_URL are MANDATORY.
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://decisiontrace.vercel.app
CLERK_AUDIENCE=

# Lyzr Agent System (Akshay's Agent Orchestration)
# In production, missing credentials trigger visible runtime error (no mock fallback).
LYZR_API_KEY=
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai/v3
LYZR_MANAGER_AGENT_ID=

# Network & CORS Security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://decisiontrace.vercel.app
LOG_LEVEL=INFO
